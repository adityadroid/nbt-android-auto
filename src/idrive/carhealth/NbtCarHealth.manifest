<?xml version="1.0" encoding="UTF-8"?>
<!-- Same connector and layout as the NbtAndroidAuto and (car-tested, side by side with it) NbtReboot manifests. -->
<plugin>
  <name>NbtCarHealth</name>
  <type>App</type>
  <file>{pluginDir}/libNbtCarHealth.so</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector>
        <type>Etch</type>
        <id>211</id>
        <asyncCallbacks>yes</asyncCallbacks>
      </pluginAppConnector>
    </dependencies>
    <parameters>
      <DescFile>{pluginDir}/NbtCarHealth.xml</DescFile>
      <TextDBFile>{pluginDir}/NbtCarHealth_ALL_Texts.zip</TextDBFile>
      <ImageDBFile>{pluginDir}/NbtCarHealth_ALL_Images.zip</ImageDBFile>
    </parameters>
  </config>
</plugin>
